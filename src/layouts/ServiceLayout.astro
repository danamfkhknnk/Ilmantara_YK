---
import Layout from "./Layout.astro";
import ArrowLink from "../components/ArrowLink.astro";
import ArrowRow from "../components/ArrowRow.astro";
import { WHATSAPP_LINK } from "../lib/site";

export type ServiceFaq = { q: string; a: string; link?: { label: string; href: string } };

const {
  title,
  description,
  path,
  h1,
  intro = [] as string[],
  image = "/images/at-the-desk.webp",
  imageAlt = "",
  whyTitle,
  whyPoints = [] as string[],
  offeringsTitle,
  offerings = [] as { title: string; desc: string }[],
  packagesTitle,
  packagesIntro = "",
  // HARGA PLACEHOLDER — karangan sementara, ganti dengan harga asli.
  startingFrom = "",
  packages = [] as { name: string; desc: string; features: string[] }[],
  processTitle = "Proses Pengerjaan",
  faqs = [] as ServiceFaq[],
  faqTitle = "Pertanyaan Umum",
  portfolioTitle = "",
  portfolioNote = "",
  portfolio = [] as { title: string; desc: string; href: string; img: string; imgAlt: string }[],
  related = [] as { label: string; href: string }[],
} = Astro.props;

const STEPS = [
  { n: "1", t: "Konsultasi (minggu 1)", d: "Ceritakan kebutuhan Anda lewat WhatsApp atau email. Kami gali target, materi, dan batas waktu." },
  { n: "2", t: "Perencanaan & Estimasi (minggu 1–2)", d: "Lingkup, struktur halaman, dan estimasi harga tetap tertulis sebelum mulai." },
  { n: "3", t: "Desain & Pengembangan (minggu 2–6)", d: "Desain, pembangunan, dan pengujian. Anda melihat demo progres tiap tahap." },
  { n: "4", t: "Peluncuran & Dukungan (minggu 6+)", d: "Rilis, cek SEO dasar dan kecepatan, plus panduan edit sendiri." },
];

const faqSchema = faqs.length
  ? [
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: faqs.map((f) => ({
          "@type": "Question",
          name: f.q,
          acceptedAnswer: { "@type": "Answer", text: f.a },
        })),
      },
    ]
  : [];
---

<Layout
  path={path}
  lang="id"
  title={title}
  description={description}
  image={image}
  alternates={[
    { hreflang: "id", href: path },
    { hreflang: "x-default", href: path },
  ]}
  jsonLd={faqSchema}
>
  <div class="bg-paper text-ink">
    <div class="mx-auto max-w-[1312px] px-5 pb-20 pt-[120px] sm:px-8 md:pt-[150px] lg:px-16">
      <p class="flex items-center gap-2.5 font-mono text-[11px] font-medium uppercase tracking-[0.05em] text-ink/55">
        <a href="/#services" class="hover:text-accent">Layanan</a>
        <span class="opacity-50">/</span>
        <span class="text-ink">{h1}</span>
      </p>
      <h1 class="mt-[18px] max-w-[860px] text-balance text-[40px] font-semibold leading-[1.02] tracking-[-0.04em] md:text-[60px]">
        {h1}
      </h1>
      <div class="mt-6 max-w-[720px] space-y-4 text-[18px] leading-[1.6] text-ink/75">
        {intro.map((p) => <p>{p}</p>)}
      </div>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href={WHATSAPP_LINK}
          target="_blank"
          rel="noopener"
          class="inline-flex h-12 items-center gap-2 rounded-[10px] bg-ink px-5 text-[15px] font-medium text-white transition-all duration-300 hover:-translate-y-0.5"
        >
          Konsultasi Gratis via WhatsApp
        </a>
        <a
          href="/contact/"
          class="inline-flex h-12 items-center gap-2 rounded-[10px] border border-ink/15 bg-white px-5 text-[15px] font-medium transition-all duration-300 hover:-translate-y-0.5"
        >
          Hubungi Kami
        </a>
      </div>

      <figure class="mt-12 overflow-hidden rounded-[24px]">
        <img src={image} alt={imageAlt} loading="lazy" class="aspect-[16/8] w-full object-cover" />
      </figure>

      <section class="mt-16 md:mt-24">
        <h2 class="max-w-[720px] text-[32px] font-semibold leading-[1.05] tracking-[-0.03em] md:text-[44px]">{whyTitle}</h2>
        <ul class="mt-8 grid gap-4 md:grid-cols-2">
          {whyPoints.map((point) => (
            <li class="rounded-2xl border border-ink/[0.09] bg-white p-5 text-[16px] leading-[1.55] text-ink/80">
              <span class="mr-2 text-accent" aria-hidden="true">◇</span>{point}
            </li>
          ))}
        </ul>
      </section>

      <section class="mt-16 md:mt-24">
        <h2 class="max-w-[720px] text-[32px] font-semibold leading-[1.05] tracking-[-0.03em] md:text-[44px]">{offeringsTitle}</h2>
        <div class="mt-8 grid gap-4 md:grid-cols-2">
          {offerings.map((offer, i) => (
            <div class="rounded-2xl border border-ink/[0.09] bg-white p-6">
              <p class="font-mono text-xs font-medium text-accent">({String(i + 1).padStart(2, "0")})</p>
              <h3 class="mt-3 text-[22px] font-semibold tracking-[-0.02em]">{offer.title}</h3>
              <p class="mt-2 text-[15px] leading-[1.6] text-ink/70">{offer.desc}</p>
            </div>
          ))}
        </div>
      </section>

      <section class="mt-16 md:mt-24">
        <h2 class="max-w-[720px] text-[32px] font-semibold leading-[1.05] tracking-[-0.03em] md:text-[44px]">{packagesTitle}</h2>
        {packagesIntro && <p class="mt-4 max-w-[680px] text-[17px] leading-[1.6] text-ink/70">{packagesIntro}</p>}
        {startingFrom && (
          <p class="mt-4 inline-block rounded-full bg-ink px-4 py-2 text-[15px] font-semibold text-white">
            Mulai dari {startingFrom}
          </p>
        )}
        <div class="mt-8 grid gap-4 md:grid-cols-3">
          {packages.map((pkg) => (
            <div class="flex flex-col rounded-2xl border border-ink/[0.09] bg-white p-6">
              <h3 class="text-[20px] font-semibold tracking-[-0.02em]">{pkg.name}</h3>
              <p class="mt-2 text-[15px] leading-[1.6] text-ink/70">{pkg.desc}</p>
              <ul class="mt-4 space-y-2">
                {pkg.features.map((f) => (
                  <li class="flex items-center gap-2 rounded-lg bg-ink/[0.04] px-2.5 py-2 text-[13px] font-medium">
                    <i class="h-1.5 w-1.5 shrink-0 rounded-full bg-accent"></i>{f}
                  </li>
                ))}
              </ul>
              <ArrowRow href={WHATSAPP_LINK} external label="Minta estimasi" class="mt-5" />
            </div>
          ))}
        </div>
      </section>

      {portfolio.length > 0 && (
        <section class="mt-16 md:mt-24">
          <h2 class="max-w-[720px] text-[32px] font-semibold leading-[1.05] tracking-[-0.03em] md:text-[44px]">{portfolioTitle}</h2>
          {portfolioNote && <p class="mt-4 max-w-[680px] text-[17px] leading-[1.6] text-ink/70">{portfolioNote}</p>}
          <div class="mt-8 grid gap-4 md:grid-cols-2">
            {portfolio.map((item) => (
              <a href={item.href} class="group overflow-hidden rounded-2xl border border-ink/[0.09] bg-white">
                <div class="overflow-hidden">
                  <img src={item.img} alt={item.imgAlt} loading="lazy" class="aspect-[16/9] w-full object-cover object-top transition-transform duration-700 ease-out group-hover:scale-[1.03]" />
                </div>
                <div class="p-6">
                  <h3 class="text-[20px] font-semibold tracking-[-0.02em] transition-colors group-hover:text-accent">{item.title}</h3>
                  <p class="mt-2 text-[15px] leading-[1.6] text-ink/60">{item.desc}</p>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

      <section class="mt-16 md:mt-24">
        <h2 class="max-w-[720px] text-[32px] font-semibold leading-[1.05] tracking-[-0.03em] md:text-[44px]">{processTitle}</h2>
        <ol class="mt-8 grid gap-4 md:grid-cols-4">
          {STEPS.map((step) => (
            <li class="rounded-2xl border border-ink/[0.09] bg-white p-5">
              <p class="font-mono text-xs font-medium text-accent">{step.n}</p>
              <h3 class="mt-2 text-[17px] font-semibold leading-snug">{step.t}</h3>
              <p class="mt-2 text-[14px] leading-[1.6] text-ink/65">{step.d}</p>
            </li>
          ))}
        </ol>
      </section>

      {faqs.length > 0 && (
        <section class="mt-16 md:mt-24">
          <h2 class="max-w-[720px] text-[32px] font-semibold leading-[1.05] tracking-[-0.03em] md:text-[44px]">{faqTitle}</h2>
          <div class="mt-8 space-y-3">
            {faqs.map((f) => (
              <details class="group rounded-2xl border border-ink/[0.09] bg-white px-5 py-4 open:shadow-[0_22px_44px_-34px_rgba(12,12,14,0.5)]">
                <summary class="cursor-pointer list-none text-[17px] font-semibold tracking-[-0.01em] [&::-webkit-details-marker]:hidden">
                  <span class="mr-2 inline-block text-accent transition-transform duration-300 group-open:rotate-90" aria-hidden="true">›</span>{f.q}
                </summary>
                <p class="mt-3 max-w-[720px] text-[15px] leading-[1.65] text-ink/70">
                  {f.a}
                  {f.link && (
                    <>
                      {" "}
                      <ArrowLink href={f.link.href} label={f.link.label} tone="accent" />
                    </>
                  )}
                </p>
              </details>
            ))}
          </div>
        </section>
      )}

      {related.length > 0 && (
        <nav aria-label="Layanan terkait" class="mt-16 md:mt-24">
          <p class="font-mono text-[11px] font-medium uppercase tracking-[0.05em] text-ink/45">Layanan terkait</p>
          <div class="mt-4 flex flex-wrap gap-2">
            {related.map((r) => (
              <a href={r.href} class="rounded-full border border-ink/[0.12] bg-white px-4 py-2.5 text-[14px] font-medium transition-colors hover:border-accent hover:text-accent">{r.label}</a>
            ))}
          </div>
        </nav>
      )}

      <section class="mt-16 rounded-[24px] bg-ink p-8 text-white md:mt-24 md:p-12">
        <h2 class="max-w-[640px] text-[32px] font-semibold leading-[1.05] tracking-[-0.03em] md:text-[44px]">
          Siap punya website yang mendatangkan pelanggan?
        </h2>
        <p class="mt-4 max-w-[560px] text-[17px] leading-[1.6] text-white/70">
          Ceritakan kebutuhan bisnis Anda. Kami balas dalam 1 hari kerja dengan
          ide awal dan estimasi harga.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href={WHATSAPP_LINK} target="_blank" rel="noopener" class="inline-flex h-12 items-center rounded-[10px] bg-white px-5 text-[15px] font-medium text-ink transition-all duration-300 hover:-translate-y-0.5">
            Konsultasi Gratis via WhatsApp
          </a>
          <a href="/contact/" class="inline-flex h-12 items-center rounded-[10px] border border-white/25 px-5 text-[15px] font-medium text-white transition-all duration-300 hover:-translate-y-0.5">
            Hubungi Kami
          </a>
        </div>
      </section>
    </div>
  </div>
</Layout>
