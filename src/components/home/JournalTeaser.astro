---
const POSTS = [
  {
    image: "/images/kcShJz4dYJymSiptkbzpYB1JF4.c7dea21d.jpg",
    tag: "CRAFT",
    readTime: "5 MIN READ",
    title: "Write the empty state first",
    excerpt:
      "The screen most people see on day one is the one we design last. I've started with it on every project for two years, and it keeps changing the product.",
  },
  {
    image: "/images/oki7L32K8gO2FzFf2oS4jv8l6gY.874223bb.jpg",
    tag: "RESEARCH",
    readTime: "6 MIN READ",
    title: "What receptionists taught me about booking flows",
    excerpt:
      "Four mornings on a clinic front desk taught me more than a month of interviews. People describe where it hurts, not what they need.",
  },
  {
    image: "/images/bstKOBl540dvdv6ooe65n1qE.6ad5e702.jpg",
    tag: "SYSTEMS",
    readTime: "7 MIN READ",
    title: "A design system is a list of decisions",
    excerpt:
      "Components are the easy part. The hard part is agreeing what 'primary' means, and writing it down where people will find it.",
  },
];
---

<section data-framer-name="10 Journal" class="px-6 py-24 md:px-10 md:pb-32">
  <p class="font-mono text-xs font-medium tracking-wide text-ink/40">
    <span class="text-accent">[10]</span> JOURNAL
  </p>

  <div class="mt-4 grid gap-10 lg:grid-cols-[1fr_320px]">
    <h2 class="text-[56px] font-semibold leading-[1.05] tracking-[-0.03em] text-ink md:text-[64px]">
      Notes from the file
    </h2>
    <div>
      <p class="text-ink/70">
        Short essays on research, systems and the business of design. One a month, no newsletter
        pop-ups.
      </p>
      <a href="/journal" class="mt-3 inline-block text-sm font-medium text-ink underline">
        Read the journal <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>

  <div class="mt-10 grid gap-6 lg:grid-cols-3">
    {POSTS.map((post) => (
      <article class="overflow-hidden rounded-2xl bg-white">
        <img src={post.image} alt={post.title} class="h-[280px] w-full rounded-t-2xl object-cover" />
        <div class="p-6">
          <div class="flex items-center justify-between text-xs">
            <span class="font-mono font-medium text-accent">{post.tag}</span>
            <span class="font-mono text-ink/40">{post.readTime}</span>
          </div>
          <h3 class="mt-4 text-xl font-semibold leading-snug text-ink">{post.title}</h3>
          <p class="mt-3 text-sm text-ink/60">{post.excerpt}</p>
        </div>
      </article>
    ))}
  </div>
</section>
