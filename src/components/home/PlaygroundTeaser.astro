---
const ITEMS = [
  {
    type: "polaroid",
    src: "/images/8RfYRjLYS5jzzkFy5XAsxIhWxc.jpg",
    alt: "Bike parked by a building entrance",
    numeral: "4",
    caption: "Sunday project: a typeface made of bike parts.",
    captionClass: "bg-[#F5B8CC] text-ink",
    top: 455, left: 16, width: 236, rotate: -4,
  },
  {
    type: "sticky",
    text: "Every button on this board is fake. Every idea is real.",
    label: "Noor · note",
    color: "bg-[#F6D548]",
    top: 517, left: 273, width: 190, rotate: 5,
  },
  {
    type: "polaroid",
    src: "/images/bWsorgWOn4V3lRBYcdqTV0UiFg.jpg",
    alt: "Dark restaurant interior with hanging lanterns",
    top: 730, left: 321, width: 220, rotate: -3,
  },
  {
    type: "polaroid",
    src: "/images/VmwnUqPBspNu7qvocsT6ErbxOOg.jpg",
    alt: "Three clay vases on a pedestal",
    caption: "clay-vases.jpg",
    top: 345, left: 531, width: 220, rotate: 1,
  },
  { type: "star", color: "bg-emerald-500", top: 655, left: 611, size: 96, rotate: -7 },
  { type: "pill", text: "#experiments", top: 805, left: 586, rotate: -2 },
  { type: "swatch", hex: "4B3BFF", color: "bg-accent", top: 325, left: 766, size: 90, rotate: -3 },
  { type: "swatch", hex: "FF5B24", color: "bg-[#FF5B24]", top: 325, left: 861, size: 90, rotate: 2 },
  { type: "swatch", hex: "C8F25A", color: "bg-[#C8F25A]", top: 325, left: 956, size: 90, rotate: -2 },
  {
    type: "ui-card",
    top: 517, left: 758, width: 284, rotate: 1,
    rows: [
      { label: "Notifications", on: true },
      { label: "Dark mode", on: false },
      { label: "Autosave", on: true },
    ],
  },
  {
    type: "sticky",
    text: "Motion study: things that bounce should also squash.",
    color: "bg-[#BEDBFF]",
    top: 728, left: 854, width: 190, rotate: -3,
  },
  {
    type: "polaroid",
    src: "/images/ujO45Z407FBRhzl7h0svDSat8U.jpg",
    alt: "Window with a plant silhouette",
    caption: "window-plant.jpg",
    top: 270, left: 1099, width: 230, rotate: 3,
  },
  {
    type: "polaroid",
    src: "/images/4lDmZ5gP61A55BIXZpeNlP7tjQ.jpg",
    alt: "High-contrast window blinds",
    caption: "dragging · bounce",
    top: 595, left: 1073, width: 235, rotate: -2,
  },
];
---

<section data-framer-name="09 Playground" class="relative overflow-hidden px-6 py-24 md:px-10">
  <p class="font-mono text-xs font-medium tracking-wide text-ink/50">
    <span class="text-accent">[09]</span> PLAYGROUND
  </p>

  <h2 class="mt-4 max-w-xl text-[40px] font-bold leading-[1.05] tracking-[-0.02em] text-ink md:text-[56px]">
    Things I make when
    <br />
    nobody's paying
  </h2>

  <p class="mt-5 max-w-md text-ink/70">
    Type experiments, motion studies and photos from the sketchbook. Drag anything around.
  </p>

  <a href="/playground" class="mt-5 inline-flex items-center gap-1.5 font-medium text-ink underline">
    Open the playground <span aria-hidden="true">→</span>
  </a>

  <div class="relative mt-10 min-h-[420px]">
    {ITEMS.map((item) => (
      <div
        class="absolute"
        style={`top: ${item.top}px; left: ${item.left}px; width: ${item.width ?? "auto"}${item.width ? "px" : ""}; transform: rotate(${item.rotate}deg);`}
      >
        {item.type === "polaroid" && (
          <div class="rounded-sm border border-ink/5 bg-white p-2 pb-0 shadow-[0_18px_40px_-16px_rgba(12,12,14,0.35)]">
            <div class="relative overflow-hidden rounded-[1px]">
              <img src={item.src} alt={item.alt} class="aspect-[4/5] w-full object-cover" />
              {item.numeral && (
                <span class="absolute left-2 top-1 font-sans text-5xl font-bold text-white drop-shadow-[0_2px_6px_rgba(0,0,0,0.5)]">
                  {item.numeral}
                </span>
              )}
            </div>
            {item.caption ? (
              <div class={`-mx-2 mt-2 px-3 py-3 text-sm font-medium leading-snug ${item.captionClass ?? "text-ink"}`}>
                {item.caption}
              </div>
            ) : (
              <div class="h-2"></div>
            )}
          </div>
        )}

        {item.type === "sticky" && (
          <div class={`${item.color} p-4 shadow-[0_14px_30px_-14px_rgba(12,12,14,0.4)]`} style={`width: ${item.width}px;`}>
            <p class="text-sm font-medium leading-snug text-ink">{item.text}</p>
            {item.label && <p class="mt-3 font-mono text-[11px] text-ink/50">{item.label}</p>}
          </div>
        )}

        {item.type === "swatch" && (
          <div class="flex flex-col items-center gap-2">
            <div class={`${item.color} rounded-md shadow-[0_10px_24px_-12px_rgba(12,12,14,0.4)]`} style={`width: ${item.size}px; height: ${item.size}px;`}></div>
            <span class="font-mono text-[11px] text-ink/60">{item.hex}</span>
          </div>
        )}

        {item.type === "ui-card" && (
          <div class="rounded-2xl border border-ink/5 bg-white p-4 shadow-[0_18px_40px_-16px_rgba(12,12,14,0.35)]" style={`width: ${item.width}px;`}>
            <p class="flex items-center gap-1.5 text-xs text-ink/40">
              <span aria-hidden="true">◇</span> Toggle, 4 states
            </p>
            <div class="mt-3 space-y-3">
              {item.rows.map((row) => (
                <div class="flex items-center justify-between">
                  <span class="text-sm font-medium text-ink">{row.label}</span>
                  <span class={`flex h-5 w-9 items-center rounded-full p-0.5 ${row.on ? "bg-accent" : "bg-ink/15"}`}>
                    <span class={`h-4 w-4 rounded-full bg-white shadow transition-all ${row.on ? "ml-auto" : ""}`}></span>
                  </span>
                </div>
              ))}
            </div>
          </div>
        )}

        {item.type === "star" && (
          <div
            class={item.color}
            style={`width: ${item.size}px; height: ${item.size}px; clip-path: polygon(50% 0%, 63% 35%, 100% 38%, 72% 60%, 82% 96%, 50% 76%, 18% 96%, 28% 60%, 0% 38%, 37% 35%);`}
          ></div>
        )}

        {item.type === "pill" && (
          <span class="inline-block whitespace-nowrap rounded-full bg-ink px-4 py-2 font-mono text-xs text-white shadow-[0_10px_24px_-12px_rgba(12,12,14,0.5)]">
            {item.text}
          </span>
        )}
      </div>
    ))}
  </div>
</section>
