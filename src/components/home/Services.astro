---
const SERVICES = [
  {
    index: "01",
    frame: "Frame 01",
    title: "Product design",
    desc: "End-to-end design for web and mobile products, from the first sketch to the shipped screen. I work inside your team's rhythm, not beside it.",
    bullets: ["UX and UI design", "Prototyping", "Usability testing", "Design QA"],
    price: "From €9,500 / month",
    faded: false,
  },
  {
    index: "02",
    frame: "Frame 02",
    title: "Websites",
    desc: "Marketing sites and launch pages that explain the product before anyone has to ask, built in Framer so your team can edit them.",
    bullets: ["Art direction", "Copy structure", "Framer build", "SEO basics"],
    price: "From €12,000 / project",
    faded: false,
  },
  {
    index: "03",
    frame: "Frame 03",
    title: "Design systems",
    desc: "A written list of decisions first, then the components. Systems your team will actually use, documented where they work.",
    bullets: ["Audit", "Tokens and components", "Documentation", "Team onboarding"],
    price: "From €18,000 / project",
    faded: true,
  },
  {
    index: "04",
    frame: "Frame 04",
    title: "Research sprints",
    desc: "Two weeks of watching real people use your product, then a short report with the three changes that matter most.",
    bullets: ["Field visits", "Interviews", "Session recordings", "Priority report"],
    price: "€7,500 fixed",
    faded: true,
  },
];
---

<section data-framer-name="06 Services" class="px-6 py-24 md:px-10 md:pb-[180px]">
  <p class="font-mono text-xs font-medium tracking-wide">
    <span class="text-accent">[06]</span> <span class="text-ink/40">SERVICES</span>
  </p>

  <div class="mt-4 grid gap-10 lg:grid-cols-[1fr_380px]">
    <h2 class="text-[52px] font-bold leading-[1.05] tracking-[-0.03em] text-ink">
      Four ways to
      <br />
      work together
    </h2>
    <div>
      <p class="text-ink/70">
        Most projects start with a research sprint and move right. Each frame is a separate
        engagement, so you can start anywhere.
      </p>
      <a href="/services" class="mt-3 inline-block text-sm font-medium text-ink underline">
        Compare services →
      </a>
    </div>
  </div>

  <div class="mt-14 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
    {SERVICES.map((service) => (
      <div class={service.faded ? "opacity-40" : ""}>
        <p class="font-mono text-xs text-ink/40"># {service.frame}</p>
        <div class="mt-2 rounded-2xl border border-ink/10 bg-white p-6">
          <div class="flex items-center justify-between">
            <span class="font-mono text-sm text-accent">({service.index})</span>
            <span class="flex h-8 w-8 items-center justify-center rounded-full border border-ink/10 text-sm">
              →
            </span>
          </div>
          <h3 class="mt-5 text-2xl font-bold leading-tight tracking-[-0.02em] text-ink">{service.title}</h3>
          <p class="mt-3 text-sm text-ink/60">{service.desc}</p>
          <ul class="mt-5 space-y-2.5">
            {service.bullets.map((bullet) => (
              <li class="flex items-center gap-2 text-sm text-ink">
                <span class="h-1.5 w-1.5 rounded-full bg-accent"></span>
                {bullet}
              </li>
            ))}
          </ul>
          <div class="mt-6 flex items-end justify-between gap-2 border-t border-ink/10 pt-5">
            <p class="text-sm font-semibold text-ink">{service.price}</p>
            <p class="text-right font-mono text-[10px] leading-tight tracking-wide text-ink/40">
              FIXED
              <br />
              SCOPE
            </p>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>
