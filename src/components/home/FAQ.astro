---
const QUESTIONS = [
  {
    question: "What kind of projects do you take on?",
    answer:
      "Digital products and websites where a real workflow needs untangling: fintech, health, commerce, travel and internal tools. I work best with teams that can ship every week.",
  },
  {
    question: "Do you work alone or with a team?",
    answer: "Mostly alone, with specialists I bring in for research or engineering when a project needs them.",
  },
  {
    question: "How do you price projects?",
    answer: "Fixed price per project or a monthly rate for ongoing work, agreed before we start. No hourly billing.",
  },
  {
    question: "Which tools do you use?",
    answer: "Framer for sites, Figma for product design, and whatever stack your engineers already use for everything else.",
  },
  {
    question: "How soon can you start?",
    answer: "Usually within two to three weeks. Rush projects sometimes sooner, ask me.",
  },
  {
    question: "Do you work with clients outside Europe?",
    answer: "Yes, as long as there are a few working hours of overlap for calls.",
  },
  {
    question: "Can you just do the visual design?",
    answer: "Yes, though I'll flag anything that looks hard to build before you commit to it.",
  },
];
---

<section data-framer-name="11 FAQ" class="px-6 py-24 md:px-10 md:pb-32">
  <div class="grid gap-10 lg:grid-cols-[1fr_1.35fr]">
    <div>
      <p class="font-mono text-xs font-medium tracking-wide">
        <span class="text-accent">[11]</span> <span class="text-ink/40">QUESTIONS</span>
      </p>
      <h2 class="mt-4 text-[56px] font-bold leading-[1.05] tracking-[-0.03em] text-ink md:text-[64px]">
        Before you ask
      </h2>
      <p class="mt-4 max-w-md text-ink/70">
        The questions I get in almost every first call. If yours isn't here, ask it in the form; I
        answer every one.
      </p>
      <a href="/contact" class="mt-3 inline-block text-sm font-medium text-ink underline">
        Ask something else <span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="overflow-hidden rounded-2xl bg-white shadow-sm">
      <div class="flex items-center justify-between border-b border-ink/10 px-6 py-4">
        <div class="flex items-center gap-2 text-sm">
          <span class="font-bold text-ink">Layers</span>
          <span class="text-ink/40">FAQ</span>
        </div>
        <span class="text-xs text-ink/40">7 items</span>
      </div>

      <div class="divide-y divide-ink/10" id="faq-list">
        {QUESTIONS.map((item, i) => (
          <div class="px-6 py-5">
            <button
              type="button"
              data-faq-toggle
              aria-expanded={i === 0 ? "true" : "false"}
              class={`flex w-full items-center gap-3 text-left ${i === 0 ? "text-accent" : "text-ink"}`}
            >
              <svg viewBox="0 0 16 16" fill="none" aria-hidden="true" class={`h-3.5 w-3.5 shrink-0 text-current transition-transform duration-150 ${i === 0 ? "rotate-90" : "rotate-0"}`}>
                <path d="M6 3.5L10.5 8L6 12.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <span aria-hidden="true" class={`font-serif text-sm shrink-0 ${i === 0 ? "text-accent" : "text-ink/40"}`}>T</span>
              <span class="text-[15px] font-bold">{item.question}</span>
            </button>
            <p class={`mt-3 pl-14 text-sm leading-relaxed text-ink/60 ${i === 0 ? "" : "hidden"}`}>
              {item.answer}
            </p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const list = document.getElementById("faq-list");
  if (list) {
    const rows = Array.from(list.children);
    rows.forEach((row, i) => {
      const button = row.querySelector("[data-faq-toggle]");
      const answer = row.querySelector("p");
      const chevron = row.querySelector("svg");
      const tIcon = row.querySelector("span[aria-hidden='true']");

      button?.addEventListener("click", () => {
        const isOpen = button.getAttribute("aria-expanded") === "true";
        rows.forEach((r, j) => {
          const b = r.querySelector("[data-faq-toggle]");
          const a = r.querySelector("p");
          const chev = r.querySelector("svg");
          const t = r.querySelector("span[aria-hidden='true']");
          const open = j === i && !isOpen;
          b?.setAttribute("aria-expanded", String(open));
          a?.classList.toggle("hidden", !open);
          chev?.classList.toggle("rotate-90", open);
          chev?.classList.toggle("rotate-0", !open);
          b?.classList.toggle("text-accent", open);
          b?.classList.toggle("text-ink", !open);
          t?.classList.toggle("text-accent", open);
          t?.classList.toggle("text-ink/40", !open);
        });
      });
    });
  }
</script>
