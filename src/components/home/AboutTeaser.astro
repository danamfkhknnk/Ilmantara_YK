---
import AboutPhoto from "../about-preview/AboutPhoto.astro";
import AboutSelection from "../about-preview/AboutSelection.astro";
import AboutStudioInfo from "../about-preview/AboutStudioInfo.astro";
import AboutTechnologies from "../about-preview/AboutTechnologies.astro";
import AboutMoreLink from "../about-preview/AboutMoreLink.astro";
---
<section data-about-section aria-labelledby="about-heading" class="w-full overflow-x-clip bg-paper font-['AboutGeist',sans-serif] text-ink">
  <div data-about-inner class="mx-auto grid max-w-[1312px] grid-cols-[minmax(0,5fr)_minmax(0,7fr)] items-center gap-[88px] px-16 py-[150px] max-[1000px]:grid-cols-1 max-[1000px]:gap-14 max-[1000px]:px-8 max-[1000px]:py-[110px] max-[640px]:px-5 max-[640px]:py-[88px]">
    <AboutPhoto />
    <div data-about-copy class="transition-[opacity,transform,filter] duration-[800ms] ease-[cubic-bezier(.22,1,.36,1)] data-[seen=false]:translate-y-[18px] data-[seen=false]:opacity-0 data-[seen=false]:blur-[4px] motion-reduce:transform-none motion-reduce:opacity-100 motion-reduce:blur-none motion-reduce:transition-none">
      <div class="flex items-center gap-[10px] font-['AboutMono',monospace] text-[11px] font-medium leading-none tracking-[.05em] text-ink/55 uppercase"><b class="font-medium text-accent">[03]</b> ABOUT</div>
      <h2 id="about-heading" data-about-heading class="mt-[26px] text-[46px] font-medium leading-[1.12] tracking-[-.04em] [text-wrap:pretty] max-[1000px]:text-[38px] max-[640px]:text-[29px]">I build websites and <span data-about-selected class="relative mx-[.02em] inline-block px-[.08em]">digital products<AboutSelection /></span> that make businesses easier to discover, use, and <span data-about-chip class="inline-flex items-center gap-[.22em] rounded-[.24em] bg-white px-[.28em] pt-[.02em] pb-[.06em] align-[.04em] text-[.9em] text-accent"><svg width=".62em" height=".62em" viewBox="0 0 12 12" aria-hidden="true"><path d="M6 .9 11.1 6 6 11.1.9 6Z" fill="none" stroke="currentColor" stroke-width="1.5" /><path d="M6 3.6 8.4 6 6 8.4 3.6 6Z" fill="currentColor" /></svg>grow.</span></h2>
      <div data-about-body class="mt-10 grid grid-cols-2 gap-7 text-[17px] font-normal leading-[1.55] tracking-[-.01em] text-ink/74 max-[640px]:grid-cols-1 max-[640px]:gap-4">
        <p>From simple landing pages to custom web applications, I turn ideas into fast, reliable, and purposeful digital experiences.</p>
        <div class="space-y-4">
          <p>I focus on where design meets technology. Understanding the problem, shaping the right solution, building it with clean code, and making sure everything works beautifully across devices.</p>
        </div>
      </div>
      <AboutStudioInfo />
      <AboutTechnologies />
    </div>
  </div>
</section>
<style>
  @font-face { font-family: AboutGeist; src: url('../../assets/fonts/hero-reference/Geist-latin-v5.woff2') format('woff2'); font-style: normal; font-weight: 100 900; font-display: swap; }
  @font-face { font-family: AboutMono; src: url('../../assets/fonts/hero-reference/GeistMono-latin-v6.woff2') format('woff2'); font-style: normal; font-weight: 100 900; font-display: swap; }
</style>
