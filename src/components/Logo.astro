---

const LAYERS = [
  { top: 12, opacity: 0.25, color: "rgb(12,12,14)" },
  { top: 8, opacity: 0.55, color: "rgb(12,12,14)" },
  { top: 3, opacity: 1, color: "rgb(75,59,255)" },
];

const siteName = "Ilmantara";
---

<a href="/" class="flex items-center gap-2.5 select-none">
  <span class="relative block h-[22px] w-[22px] shrink-0">
    {LAYERS.map((layer) => (
      <span
        class="absolute left-[3px] h-[7px] w-4 rounded-sm"
        style={{ top: `${layer.top}px`, backgroundColor: layer.color, opacity: layer.opacity }}
      />
    ))}
  </span>
  <span class="flex items-center gap-2.5 leading-none">
    <span class="text-[14px] font-semibold tracking-[-0.02em] text-ink">{siteName}</span>
    <span class="text-[13px] tracking-[-0.01em] text-ink/45">/ Portfolio</span>
  </span>
</a>
