---
import { getNavigation, getSocialLinks, getSiteSettings } from "../lib/sanity";

const [navigation, socialLinks, siteSettings] = await Promise.all([
  getNavigation(),
  getSocialLinks(),
  getSiteSettings(),
]);

const PAGES = navigation.map((item) => ({ label: item.label, to: item.href }));
const ELSEWHERE = socialLinks;

// The "Copy email" button copies whichever social link looks like an email
// (an `mailto:` href), so editing the address in Sanity's socialLinks list
// updates the button too instead of needing a separate field for it.
const emailLink = socialLinks.find((item) => item.href.startsWith("mailto:"));
const copyEmail = emailLink ? emailLink.href.replace(/^mailto:/, "") : "hello@ilmantara.com";

// Position of each of the 8 Figma/Framer-style selection handles around the
// footer mark, ported 1:1 from the reference's `.lff-mark` overlay (corners
// + edge midpoints of the bounding box).
const HANDLES = [
  { left: "0%", top: "0%" },
  { left: "50%", top: "0%" },
  { left: "100%", top: "0%" },
  { left: "100%", top: "50%" },
  { left: "100%", top: "100%" },
  { left: "50%", top: "100%" },
  { left: "0%", top: "100%" },
  { left: "0%", top: "50%" },
];
---

<footer data-framer-name="Footer" class="bg-paper px-6 pt-24 pb-10 md:px-10 md:pt-[190px]">
  <p class="font-mono text-xs font-medium tracking-wide text-accent">[12] NEXT STEP</p>

  <div class="mt-4 grid gap-10 lg:grid-cols-[1fr_280px_280px]">
    <div>
      <h2 class="text-[56px] font-semibold leading-[1.05] tracking-[-0.03em] text-ink md:text-[64px]">
        Got a messy workflow? Let's untangle it.
      </h2>
      <p class="mt-4 text-ink/70">
        Tell me what's slow, confusing or costing you support tickets. I reply within one working
        day with a first idea and a fixed price.
      </p>
      <div class="mt-5 flex flex-wrap gap-3">
        <button
          type="button"
          data-copy-email={copyEmail}
          class="flex items-center gap-1.5 rounded-xl bg-white px-4 py-3 text-sm font-medium text-ink transition-colors"
        >
          Copy email
        </button>
      </div>
    </div>

    <div class="rounded-2xl bg-white p-6">
      <div class="flex items-center justify-between text-sm">
        <span class="font-medium text-ink">Pages</span>
        <span class="text-ink/40">{PAGES.length}</span>
      </div>
      <ul class="mt-4 space-y-3">
        {PAGES.map((page, i) => (
          <li class="flex items-center justify-between text-sm">
            <a href={page.to} class="font-medium text-ink hover:underline">
              {page.label}
            </a>
            <span class="font-mono text-xs text-ink/40">{String(i + 1).padStart(2, "0")}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="rounded-2xl bg-white p-6">
      <div class="flex items-center justify-between text-sm">
        <span class="font-medium text-ink">Elsewhere</span>
        <span class="text-ink/40" aria-hidden="true">↗</span>
      </div>
      <ul class="mt-4 space-y-3">
        {ELSEWHERE.map((item) => (
          <li class="flex items-center justify-between text-sm">
            <a href={item.href} class={item.muted ? "text-ink/50" : "font-medium text-ink hover:underline"}>
              {item.label}
            </a>
            <span class="text-ink/30" aria-hidden="true">
              {item.muted ? "@" : "↗"}
            </span>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div
    id="footer-mark"
    aria-hidden="true"
    class="relative mt-[56px] w-full select-none whitespace-nowrap font-bold leading-[0.8] tracking-[-0.065em] transition-colors duration-[600ms] ease-[cubic-bezier(0.22,1,0.36,1)] text-transparent hover:text-ink [-webkit-text-stroke:1.5px_rgb(12,12,14)] text-[83px] min-[640px]:text-[145px] min-[768px]:mt-[88px] min-[768px]:text-[168px] min-[1024px]:text-[230px] min-[1280px]:text-[293px] min-[1440px]:text-[332px] min-[1536px]:text-[355px]"
  >
    {siteSettings.name}
    <div class="pointer-events-none absolute inset-0" style="border: 1.5px solid rgb(var(--color-accent-rgb)); opacity: 1;">
      {HANDLES.map((handle) => (
        <span
          class="absolute h-2.5 w-2.5 -ml-[5px] -mt-[5px] bg-white"
          style={`left: ${handle.left}; top: ${handle.top}; border: 1.5px solid rgb(var(--color-accent-rgb));`}
        />
      ))}
    </div>
  </div>

  <div class="mt-6 flex flex-col gap-2 border-t border-ink/10 pt-6 text-xs text-ink/50 sm:flex-row sm:items-center sm:justify-between">
    <span>© 2026 {siteSettings.name}. All rights reserved.</span>
    <span>{siteSettings.location}</span>
    <a href="#top" class="hover:text-ink">Back to top</a>
  </div>
</footer>

<script>
  const button = document.querySelector("[data-copy-email]");
  button?.addEventListener("click", async () => {
    const email = button.getAttribute("data-copy-email") ?? "";
    const originalLabel = button.textContent;
    try {
      await navigator.clipboard.writeText(email);
      button.textContent = "Copied!";
    } catch {
      button.textContent = "Couldn't copy";
    }
    setTimeout(() => {
      button.textContent = originalLabel;
    }, 1800);
  });
</script>
