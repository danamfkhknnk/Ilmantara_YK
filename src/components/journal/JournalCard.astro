---
import type { JournalPost } from "../../data/journal";

const { post, titleClass = "text-[28px]" } = Astro.props as {
  post: JournalPost;
  titleClass?: string;
};
---

<a
  href={`/journal/${post.slug}/`}
  class="group block overflow-hidden rounded-[24px] bg-white p-3 shadow-[0_26px_50px_-38px_rgba(12,12,14,0.35)] transition-[transform,box-shadow] duration-500 hover:-translate-y-1.5 hover:shadow-[0_40px_70px_-40px_rgba(12,12,14,0.5)]"
>
  <div class="overflow-hidden rounded-2xl">
    <img
      src={post.cover}
      alt={post.coverAlt}
      loading="lazy"
      class="aspect-[16/10] w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03]"
    />
  </div>
  <div class="px-3 pb-3 pt-5">
    <p class="flex items-center justify-between font-mono text-[11px] font-medium uppercase tracking-[0.04em]">
      <span class="text-accent">{post.tag}</span>
      <span class="text-ink/45">{post.readTime}</span>
    </p>
    <h3 class={`mt-3 font-semibold leading-[1.08] tracking-[-0.025em] text-ink transition-colors duration-300 group-hover:text-accent ${titleClass}`}>
      {post.title}
    </h3>
    <p class="mt-2.5 text-[15px] leading-[1.55] text-ink/60">{post.excerpt}</p>
  </div>
</a>
