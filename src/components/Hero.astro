---
// Reference hero port for /hero-preview only.
// Specification: research/hero-reference-20261012T095713Z/README.md.
import glyphData from "../data/hero-glyphs.json";

const CANVAS_W = 1440;
const CANVAS_H = 900;
const MOBILE_CANVAS_W = 420;
const MOBILE_CANVAS_H = 860;
const TOTAL_DURATION = 12.4;

const ACCENT = "#4B3BFF";
const INK = "#0C0C0E";
const PAPER = "#ECECE8";
const MARA_COLOR = "#FF5B24";
const GUIDE_COLOR = "#FF3D6E";

const STATEMENT_MUTED = "Product designer in Rotterdam.";
const STATEMENT = "I turn complicated workflows into software people actually keep open.";
const CURRENT_ROLE = "Design lead at Orrin";
const AVAILABILITY = "Booking projects from November";
const PRIMARY_LABEL = "See selected work";
const PRIMARY_LINK = "#work";
const SECONDARY_LABEL = "Book a 20-min intro";
const SECONDARY_LINK = "/contact";
const PHOTO_SRC = "https://images.unsplash.com/photo-1558655146-9f40138edfeb?w=900&q=80&auto=format&fit=crop";
const PHOTO_NAME = "at-the-desk.jpg";
const COMMENT_AUTHOR = "Mara · PM";
const COMMENT_TEXT = "Can the name go bigger? It's the first thing a client reads.";
const REPLY_AUTHOR = "Theo · Eng";
const REPLY_TEXT = "Bumped it to 208. Shipping.";
const PROJECT_NAME = "Orrin";
const PROJECT_AMOUNT = "€12,480.00";
const CHROME = "absolute rounded-xl border border-ink/10 bg-white/[.82] backdrop-blur-[14px] backdrop-saturate-[1.4] shadow-[inset_0_1px_0_rgba(255,255,255,.8),0_18px_40px_-18px_rgba(12,12,14,.28),0_2px_6px_rgba(12,12,14,.05)]";
const FIELD = "flex h-7 items-center gap-2 rounded-md bg-ink/[.045] px-2 font-mono text-[12px] font-medium leading-none transition-[background,color] duration-200";
---

<section data-hero-anim data-framer-name="01 Hero" class="relative">
  <div id="ha-container" class="relative -mt-14 h-screen min-h-[560px] cursor-none overflow-hidden bg-paper font-sans text-[12px] text-ink select-none [--font-sans:HeroGeist,Geist,sans-serif] [--font-mono:HeroMono,monospace]">
    <div
      aria-hidden="true"
      class="absolute inset-0 opacity-90"
      style="background-image: radial-gradient(circle at 1px 1px, rgba(12,12,14,0.16) 1px, transparent 1.2px); background-size: 24px 24px;"
    >
    </div>
    <div
      aria-hidden="true"
      class="absolute inset-0"
      style="background: radial-gradient(1200px 520px at 50% 34%, rgba(255,255,255,0.75), transparent 70%);"
    >
    </div>

    <div id="ha-canvas" class="absolute left-0 top-0 origin-top-left">
      <div id="ha-artboard" class="absolute inset-0 origin-[50%_40%]">
      <h1 class="sr-only">{glyphData.text}</h1>
      <div
        id="ha-breadcrumb"
        class="absolute flex items-center gap-2.5 font-mono text-[11px] font-medium leading-none tracking-[0.02em]"
        style={`color: rgba(12,12,14,.5);`}
      >
        <span style={`color:${ACCENT}`}>#</span>
        <span>Home — <span id="ha-mode-label">Desktop</span></span>
        <span class="opacity-60" id="ha-dims-label">1440 × 900</span>
      </div>

      <div id="ha-badge-role" class="absolute flex items-center gap-[7px] font-mono text-[11px] font-medium leading-[11px] tracking-[0.04em] uppercase whitespace-nowrap" style={`color:${ACCENT}`}>
        <svg width="10" height="10" viewBox="0 0 10 10">
          <path d="M5 0.8 L9.2 5 L5 9.2 L0.8 5 Z" fill="none" stroke={ACCENT} stroke-width="1.3"></path>
          <path d="M5 3 L7 5 L5 7 L3 5 Z" fill={ACCENT}></path>
        </svg>
        <span>{CURRENT_ROLE}</span>
      </div>
      <div id="ha-badge-avail" class="absolute flex items-center gap-[7px] font-mono text-[11px] font-medium leading-[11px] tracking-[0.04em] uppercase whitespace-nowrap" style="color: rgba(12,12,14,.62);">
        <span style="width:7px;height:7px;border-radius:9px;background:#19C37D;box-shadow:0 0 0 3px rgba(25,195,125,.18);"></span>
        <span>{AVAILABILITY}</span>
      </div>

      <svg id="ha-name-svg" class="absolute left-0 top-0 overflow-visible" aria-hidden="true">
        <defs>
          <clipPath id="ha-glyph-clip"></clipPath>
          <radialGradient id="ha-spot-rg">
            <stop offset="0.72" stop-color="#fff"></stop>
            <stop offset="1" stop-color="#fff" stop-opacity="0"></stop>
          </radialGradient>
          <mask id="ha-spot-mask" maskUnits="userSpaceOnUse" x="-2000" y="-3000" width="12000" height="6000">
            <circle id="ha-spot-mask-circle" r="0" fill="url(#ha-spot-rg)"></circle>
          </mask>
        </defs>
        <g id="ha-glyph-scale">
          <g id="ha-glyph-fill"></g>
          <g id="ha-glyph-outline"></g>
          <!-- Spotlight: a carousel photo peeking through the glyph shapes,
               clipped to the letters and masked by a soft circle that either
               follows the scripted second cursor (D≈9.45-11.9s) or, as a
               permanent easter egg, the real mouse whenever it hovers the
               wordmark directly. See docs/components/Hero-04-Wordmark.md. -->
          <g id="ha-spotlight" clip-path="url(#ha-glyph-clip)" mask="url(#ha-spot-mask)">
            <image id="ha-spot-img-0" preserveAspectRatio="xMidYMid slice"></image>
            <image id="ha-spot-img-1" preserveAspectRatio="xMidYMid slice"></image>
            <image id="ha-spot-img-2" preserveAspectRatio="xMidYMid slice"></image>
            <image id="ha-spot-img-3" preserveAspectRatio="xMidYMid slice"></image>
            <rect id="ha-spot-overlay" opacity="0.18"></rect>
          </g>
          <circle id="ha-spot-ring" r="0" fill="none" stroke={ACCENT} stroke-width="1" stroke-dasharray="3 4" opacity="0.55"></circle>
          <g id="ha-anchors"></g>
        </g>
        <g id="ha-selbox">
          <rect id="ha-selrect" fill="none" stroke={ACCENT} stroke-width="1.5"></rect>
          <g id="ha-handles"></g>
        </g>
      </svg>
      <svg id="ha-hover-svg" class="pointer-events-none absolute left-0 top-0 z-[25] overflow-visible" aria-hidden="true">
        <g id="ha-hover-box" style="opacity:0"><rect fill="none" stroke={ACCENT} stroke-width="1.5"></rect></g>
        <g id="ha-guides"></g>
        <text id="ha-hover-label" class="font-mono text-[10px] font-medium" fill={ACCENT}></text>
      </svg>
      <div id="ha-dimlabel" class="absolute origin-center rounded-[4px] bg-accent px-[7px] py-[5px] font-mono text-[11px] font-medium leading-none whitespace-nowrap text-white transition-[background] duration-200"></div>

      <p id="ha-statement" class="absolute m-0 text-center" style="text-wrap: balance;">
        <span style="color: rgba(12,12,14,.46);">{STATEMENT_MUTED} </span><span>{STATEMENT}</span>
      </p>

      <div id="ha-cta" class="absolute left-0 flex flex-wrap justify-center gap-[10px]">
        <a href={PRIMARY_LINK} id="ha-cta-primary" class="group box-border inline-flex h-12 cursor-none items-center gap-[10px] rounded-[10px] px-5 text-[15px] font-medium transition-[transform,box-shadow,background] duration-[350ms] ease-[cubic-bezier(.22,1,.36,1)] hover:-translate-y-0.5 hover:shadow-[0_14px_26px_-14px_rgba(12,12,14,.55)] active:translate-y-0 active:scale-[.98] focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-accent" style={`background:${INK}; color:#fff; line-height:15px; letter-spacing:-0.015em;`}>
          {PRIMARY_LABEL}
          <svg class="transition-transform duration-[350ms] ease-[cubic-bezier(.22,1,.36,1)] group-hover:translate-x-0.5 group-hover:translate-y-0.5" width="14" height="14" viewBox="0 0 14 14"><path d="M3 3 L11 11 M11 4.5 L11 11 L4.5 11" stroke="currentColor" stroke-width="1.6" fill="none"></path></svg>
        </a>
        <a href={SECONDARY_LINK} id="ha-cta-secondary" class="box-border inline-flex h-12 cursor-none items-center gap-[10px] rounded-[10px] px-5 text-[15px] font-medium transition-[transform,box-shadow,background] duration-[350ms] ease-[cubic-bezier(.22,1,.36,1)] hover:-translate-y-0.5 hover:shadow-[0_14px_26px_-14px_rgba(12,12,14,.55)] active:translate-y-0 active:scale-[.98] focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-accent" style="background: rgba(255,255,255,.9); color: #0C0C0E; border: 1px solid rgba(12,12,14,0.10); line-height:15px; letter-spacing:-0.015em;">
          <span style={`width:7px;height:7px;border-radius:9px;background:${ACCENT};`}></span>
          {SECONDARY_LABEL}
        </a>
      </div>

      <div id="ha-photo" class="absolute">
        <div class="absolute left-0 -top-[18px] flex items-center gap-1.5 font-mono text-[10px] font-medium leading-none text-ink/55">
          <span>▣</span><span>{PHOTO_NAME}</span>
        </div>
        <img src={PHOTO_SRC} alt="Noor sketching interface ideas on a tablet" draggable="false" class="block h-full w-full rounded-[2px] object-cover" style="box-shadow: 0 20px 40px -20px rgba(12,12,14,.45);" />
      </div>

      <div id="ha-card" class="absolute w-[206px]">
        <div class="absolute left-0 -top-[18px] flex items-center gap-1.5 font-mono text-[10px] font-medium leading-none whitespace-nowrap text-accent">
          <span>◇</span><span>Now: {PROJECT_NAME} app</span>
        </div>
        <div class="rounded-[14px] border border-ink/10 bg-white p-[14px] shadow-[0_24px_44px_-22px_rgba(12,12,14,.42)]">
          <div class="flex items-center justify-between text-[11px] font-medium leading-none text-ink/55">
            <span class="flex items-center gap-1.5"><span class="inline-block size-4 rounded-[5px] bg-ink"></span>Pay run · Oct</span>
            <span class="text-[#10B37A]">● Ready</span>
          </div>
          <div class="mt-[14px] text-[25px] font-semibold leading-none tracking-[-0.04em]">{PROJECT_AMOUNT}</div>
          <div class="mt-[5px] text-[11px] font-normal leading-[1.3] text-ink/50">14 freelancers · paid Friday</div>
          <div id="ha-chart" class="mt-3 flex h-[38px] items-end gap-1">
            {[.42, .6, .5, .78, .66, .92, .7, 1].map((ratio, i) => (
              <div data-chart-ratio={ratio} class:list={["min-w-0 flex-1 rounded-[3px]", i === 7 ? "bg-accent" : "bg-ink/[.12]"]}></div>
            ))}
          </div>
          <div class="mt-3 flex h-8 items-center justify-center rounded-lg bg-accent text-[12px] font-medium leading-none text-white">Approve pay run</div>
        </div>
      </div>

      </div>
      <div id="ha-mara-cursor" class="pointer-events-none absolute z-30" style="opacity:0; will-change: transform;">
        <svg width="20" height="22" viewBox="0 0 20 22" class="absolute -left-0.5 -top-0.5 drop-shadow-[0_2px_3px_rgba(0,0,0,.2)]">
          <path d="M2.5 2.5 L2.5 18 L7 13.8 L10.2 20.4 L13 19.1 L9.9 12.6 L16 12.3 Z" fill={MARA_COLOR} stroke="#fff" stroke-width="1.4" stroke-linejoin="round"></path>
        </svg>
        <div class="absolute whitespace-nowrap text-[11px] font-medium leading-none tracking-[-0.01em] text-white shadow-[0_4px_10px_rgba(0,0,0,.12)]" style={`left:14px; top:17px; background:${MARA_COLOR}; padding:5px 7px; border-radius:3px 8px 8px 8px;`}>{COMMENT_AUTHOR}</div>
      </div>

      <!-- Avatar + collapsed-thread badge: the comment/reply card scales/fades
           out of this same anchor point as it collapses (K window). -->
      <div id="ha-comment-pulse" class="absolute size-8 rounded-full border-2 border-[#FF5B24] opacity-0" aria-hidden="true"></div>
      <div id="ha-thread-anchor" class="absolute z-20" style="opacity:0;">
        <div id="ha-avatar" class="absolute -left-[14px] -top-[30px] flex size-7 items-center justify-center rounded-[50%_50%_50%_4px] border-2 border-white bg-[#FF5B24] text-[12px] font-semibold leading-none text-white shadow-[0_6px_14px_rgba(255,91,36,.35)]">
          {COMMENT_AUTHOR[0]}
          <span id="ha-thread-badge" class="absolute -right-[9px] -top-[7px] h-4 min-w-[16px] rounded-[9px] text-center text-[9px] font-semibold leading-4 text-white" style={`background:${INK};`}>2</span>
        </div>
        <div id="ha-comment" class="absolute -left-[290px] -top-[6px] w-[262px] rounded-xl border border-ink/10 bg-white px-3 py-[11px] shadow-[0_22px_44px_-20px_rgba(12,12,14,.35)]">
          <div class="flex items-center gap-1.5 text-[12px] font-semibold leading-none">{COMMENT_AUTHOR}<span class="text-[11px] font-normal leading-none text-ink/45">just now</span></div>
          <div class="mt-1.5 min-h-[35px] text-[13px] font-normal leading-[1.35] tracking-[-0.01em]"><span id="ha-comment-text"></span><span id="ha-comment-caret" class="ml-px inline-block h-[14px] w-[1.5px] align-[-2px] bg-[#FF5B24]"></span></div>
          <div id="ha-reply-block" class="mt-[9px] border-t pt-[9px]" style="border-color: rgba(12,12,14,.1); opacity:0;">
            <div class="text-[12px] font-semibold leading-none text-[#10B37A]">{REPLY_AUTHOR}</div>
            <div class="mt-[5px] text-[13px]" style="line-height:1.35;">{REPLY_TEXT}</div>
          </div>
        </div>
      </div>

      <div id="ha-theo-cursor" class="pointer-events-none absolute z-30" style="opacity:0; will-change: transform;">
        <svg width="20" height="22" viewBox="0 0 20 22" class="absolute -left-0.5 -top-0.5 drop-shadow-[0_2px_3px_rgba(0,0,0,.2)]">
          <path d="M2.5 2.5 L2.5 18 L7 13.8 L10.2 20.4 L13 19.1 L9.9 12.6 L16 12.3 Z" fill="#10B37A" stroke="#fff" stroke-width="1.4" stroke-linejoin="round"></path>
        </svg>
        <div class="absolute whitespace-nowrap text-[11px] font-medium leading-none tracking-[-0.01em] text-white shadow-[0_4px_10px_rgba(0,0,0,.12)]" style="left:14px; top:17px; background:#10B37A; padding:5px 7px; border-radius:3px 8px 8px 8px;">{REPLY_AUTHOR}</div>
      </div>

      <div id="ha-pen-cursor" class="absolute pointer-events-none" style="opacity:0; z-index:30; will-change: transform;">
        <svg width="22" height="22" viewBox="0 0 22 22" style="position:absolute; left:-3px; top:-3px; filter: drop-shadow(0 2px 3px rgba(0,0,0,.18));">
          <path d="M3 3 L9 17 L11.5 11.5 L17 9 Z" fill="#fff" stroke={ACCENT} stroke-width="1.6" stroke-linejoin="round"></path>
          <circle cx="10" cy="10" r="1.6" fill={ACCENT}></circle>
        </svg>
        <div id="ha-pen-cursor-label" class="absolute whitespace-nowrap text-[11px] font-medium leading-none tracking-[-0.01em] text-white shadow-[0_4px_10px_rgba(0,0,0,.12)]" style={`left:14px; top:17px; background:${ACCENT}; padding:5px 7px; border-radius:3px 8px 8px 8px;`}></div>
      </div>

      <div id="ha-you-cursor" class="pointer-events-none absolute z-30 hidden" style="will-change: transform;">
        <svg width="20" height="22" viewBox="0 0 20 22" style="position: absolute; left: -2px; top: -2px; filter: drop-shadow(0 2px 3px rgba(0,0,0,.2));">
          <path d="M2.5 2.5 L2.5 18 L7 13.8 L10.2 20.4 L13 19.1 L9.9 12.6 L16 12.3 Z" fill={ACCENT} stroke="#fff" stroke-width="1.4" stroke-linejoin="round"></path>
        </svg>
        <div class="absolute whitespace-nowrap text-[11px] font-medium leading-none tracking-[-0.01em] text-white shadow-[0_4px_10px_rgba(0,0,0,.12)]" style={`left:14px; top:17px; background:${ACCENT}; padding:5px 7px; border-radius:3px 8px 8px 8px;`}>You</div>
      </div>

      <!-- These chrome panels use fixed CANVAS-space coordinates straight from
           the reference (left:36/top:590 and left:1168/top:548, desktop-only),
           not CSS bottom/right screen anchoring — so they pan/scale with the
           rest of the canvas instead of sticking to the viewport edge. -->
      <div id="ha-layers" class:list={[CHROME, "left-[36px] top-[590px] h-[262px] w-[236px] overflow-hidden text-[12px] leading-none"]}>
        <div class="flex gap-3.5 border-b border-ink/10 px-3.5 pt-3 pb-2.5 font-semibold">
          <span>Layers</span><span class="font-medium text-ink/40">Assets</span>
          <span class="ml-auto font-mono text-[10px] font-medium text-ink/40">Home</span>
        </div>
        <div id="ha-layers-list" class="p-1.5"></div>
      </div>

      <div id="ha-inspect" class:list={[CHROME, "left-[1168px] top-[548px] h-[304px] w-[236px] overflow-hidden"]}>
        <div class="flex gap-3.5 border-b border-ink/10 px-3.5 pt-3 pb-2.5 text-[12px] font-semibold leading-none"><span>Design</span><span class="font-medium text-ink/40">Prototype</span><span class="font-medium text-ink/40">Inspect</span></div>
        <div class="grid gap-3.5 px-3.5 py-3">
          <div>
            <div id="ha-inspect-name" class="mb-[9px] overflow-hidden text-[11px] font-semibold leading-none text-ink/80 text-ellipsis whitespace-nowrap">Nothing selected</div>
            <div class="grid grid-cols-2 gap-1.5">
              <div class={FIELD}><span class="text-[10px] text-ink/40">X</span><span id="ha-inspect-x">–</span></div>
              <div class={FIELD}><span class="text-[10px] text-ink/40">Y</span><span id="ha-inspect-y">–</span></div>
              <div id="ha-field-w" class={FIELD}><span class="text-[10px] text-ink/40">W</span><span id="ha-inspect-w">–</span></div>
              <div id="ha-field-h" class={FIELD}><span class="text-[10px] text-ink/40">H</span><span id="ha-inspect-h">–</span></div>
            </div>
          </div>
          <div id="ha-inspect-text-block">
            <div class="mb-[9px] text-[11px] font-semibold leading-none text-ink/80">Text</div>
            <div class="flex justify-between text-[12px] font-medium leading-none"><span>Geist</span><span class="text-ink/50">Semibold</span></div>
            <div class="mt-2 grid grid-cols-2 gap-1.5">
              <div id="ha-field-font" class={FIELD}><span class="text-[10px] text-ink/40">Aa</span><span id="ha-inspect-fontsize">200</span></div>
              <div class={FIELD}><span class="text-[10px] text-ink/40">|A|</span>-5%</div>
            </div>
          </div>
          <div>
            <div class="mb-[9px] text-[11px] font-semibold leading-none text-ink/80">Fill</div>
            <div class="flex items-center gap-2 font-mono text-[12px] font-medium leading-none">
              <span id="ha-inspect-swatch" class="size-4 shrink-0 rounded-[4px] border border-ink/10 bg-ink bg-cover"></span>
              <span id="ha-inspect-fill">RGB(12, 12, 14)</span>
              <span id="ha-inspect-fill-detail" class="ml-auto text-ink/45">100%</span>
            </div>
          </div>
        </div>
      </div>

      <div id="ha-toolbar" class:list={[CHROME, "left-[570px] top-[842px] flex h-11 w-[300px] items-center justify-center gap-1 overflow-visible"]}>
        <button id="ha-tool-move" class="flex h-8 w-9 items-center justify-center rounded-lg" aria-label="Move">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="#0C0C0E" stroke-width="1.4" stroke-linejoin="round"><path d="M3 2 L3 13 L6.2 10 L8.5 14.5 L10.4 13.6 L8.2 9.2 L12.5 9 Z"></path></svg>
        </button>
        <button id="ha-tool-frame" class="flex h-8 w-9 items-center justify-center rounded-lg" aria-label="Frame">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="#0C0C0E" stroke-width="1.4" stroke-linejoin="round"><path d="M5 1.5v13M11 1.5v13M1.5 5h13M1.5 11h13"></path></svg>
        </button>
        <button id="ha-tool-pen" class="flex h-8 w-9 items-center justify-center rounded-lg" aria-label="Pen">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="#0C0C0E" stroke-width="1.4" stroke-linejoin="round"><path d="M3 13 L5 7 L9.5 2.5 L13.5 6.5 L9 11 Z M3 13 L7 9"></path><circle cx="7.4" cy="8.6" r="1"></circle></svg>
        </button>
        <button id="ha-tool-text" class="flex h-8 w-9 items-center justify-center rounded-lg" aria-label="Text">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="#0C0C0E" stroke-width="1.4" stroke-linejoin="round"><path d="M3 3.5h10M8 3.5v10M6 13.5h4"></path></svg>
        </button>
        <button id="ha-tool-comment" class="flex h-8 w-9 items-center justify-center rounded-lg" aria-label="Comment">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="#0C0C0E" stroke-width="1.4" stroke-linejoin="round"><path d="M8 2.5a5.5 5.5 0 1 1-4.3 8.9L2.5 13.5l.6-3A5.5 5.5 0 0 1 8 2.5z"></path></svg>
        </button>
        <button id="ha-tool-scale" class="flex h-8 w-9 items-center justify-center rounded-lg" aria-label="Scale">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="#0C0C0E" stroke-width="1.4" stroke-linejoin="round"><path d="M2.5 13.5h4M2.5 13.5v-4M13.5 2.5h-4M13.5 2.5v4M3 13l10-10"></path></svg>
        </button>
        <span class="mx-1.5 h-5 w-px" style="background: rgba(12,12,14,.1);"></span>
        <span class="font-mono text-[11px] font-medium leading-none text-ink/55">100%</span>
      </div>
    </div>

    <div id="ha-ruler" class="pointer-events-none absolute inset-0" style="opacity:1;">
      <svg id="ha-ruler-h" style="position:absolute; left:0; top:0; background: rgba(248,248,246,.92); border-bottom:1px solid rgba(12,12,14,.1);"></svg>
      <svg id="ha-ruler-v" style="position:absolute; left:0; top:20px; background: rgba(248,248,246,.92); border-right:1px solid rgba(12,12,14,.1);"></svg>
      <div id="ha-ruler-corner" style="position:absolute; left:0; top:0; width:20px; height:20px; background:rgb(248,248,246); border-right:1px solid rgba(12,12,14,.1); border-bottom:1px solid rgba(12,12,14,.1);"></div>
    </div>
  </div>
</section>

<style>
  @font-face {
    font-family: HeroGeist;
    src: url("../assets/fonts/hero-reference/Geist-latin-v5.woff2") format("woff2");
    font-weight: 100 900;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: HeroMono;
    src: url("../assets/fonts/hero-reference/GeistMono-latin-v6.woff2") format("woff2");
    font-weight: 100 900;
    font-style: normal;
