---
const facts = [
  ['Based in', 'Yogyakarta, Indonesia'],
  ['Working with', 'Businesses, startups & teams'],
  ['Language', 'English (Expert)'],
  ['Focus', 'Web development & AI automation'],
];
---
<dl id="studio-information" tabindex="-1" data-about-facts class="mt-10 grid scroll-mt-8 grid-cols-3 border-t border-ink/10 outline-none max-[640px]:grid-cols-1">
  {facts.map(([label,value]) => <div class="pt-4 pr-4">
    <dt class="mb-2 block font-['AboutMono',monospace] text-[11px] font-medium leading-none tracking-[.05em] text-ink/50 uppercase">{label}</dt>
    <dd class="text-[16px] font-medium leading-[1.3] tracking-[-.015em]">{value}</dd>
  </div>)}
</dl>
