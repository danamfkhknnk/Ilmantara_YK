---
import { getProjects } from "../../lib/sanity";

// All content — title, description, category, year, URL, image — comes from CMS.
const projects = await getProjects();

const CASES = projects.map((p) => {
  const brand = p.name ?? p.title.split(" ").slice(0, 2).join(" ");
  return {
    name: brand,
    title: p.title,
    href: p.url ?? `/work/${p.slug}`,
    external: !!p.url,
    tag: p.category ?? "Project",
    year: p.year ?? "",
    summary: p.description ?? "",
    img: p.imageUrl ?? "/images/work/project-wellness.png",
    imgAlt: p.imageAlt ?? p.title,
  };
});
---

<section data-framer-name="02 Case studies" class="bg-paper">
  <div class="mx-auto grid max-w-[1312px] grid-cols-1 gap-x-8 gap-y-[72px] px-5 pb-[87px] pt-10 sm:px-8 md:grid-cols-1 lg:grid-cols-2 lg:px-16 lg:pb-[140px]">
    {CASES.map((c) => (
      <a
        href={c.href}
        target={c.external ? "_blank" : undefined}
        rel={c.external ? "noopener noreferrer" : undefined}
        class="group block text-ink"
      >
        <!-- canvas label -->
        <div class="mb-2.5 flex items-center justify-between font-mono text-[11px] font-medium uppercase tracking-[0.04em] text-ink/50">
          <span>{c.tag}</span>
          {c.year && <span>{c.year}</span>}
        </div>

        <!-- project image -->
        <div
          data-tilt
          class="relative aspect-[8/5] overflow-hidden rounded-2xl transition-transform duration-200 ease-out will-change-transform"
        >
          <img
            src={c.img}
            alt={c.imgAlt}
            loading="lazy"
            class="absolute inset-0 h-full w-full scale-[1.06] object-cover object-top transition-all duration-700 ease-out group-hover:scale-[1.03] group-hover:blur-[2px]"
          />
          <span class="absolute left-1/2 top-1/2 flex h-14 w-14 -translate-x-1/2 -translate-y-1/2 scale-90 items-center justify-center rounded-full bg-white text-accent opacity-0 transition-all duration-300 group-hover:scale-100 group-hover:opacity-100">
            <svg width="18" height="18" viewBox="0 0 14 14" aria-hidden="true">
              <path d="M3.5 10.5L10.5 3.5M5 3.5h5.5V9" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </span>
        </div>

        <!-- meta -->
        <div class="mt-4">
          <h3 class="text-[20px] font-semibold tracking-[-0.01em] text-ink transition-colors duration-300 group-hover:text-accent">{c.title}</h3>
          <p class="mt-2 max-w-[480px] text-[15px] leading-[1.55] text-ink/60">{c.summary}</p>
        </div>
      </a>
    ))}
  </div>
</section>

<script>
  // Pointer-tracked 3D tilt on the hero visual, mirroring the reference
  // Layerfolio Case Card (rotate follows the cursor, eases back on leave).
  // Disabled on touch / reduced-motion.
  if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    document.querySelectorAll("[data-tilt]").forEach((el) => {
      const card = el.closest("a");
      if (!card || !window.matchMedia("(hover: hover)").matches) return;
      const MAX = 7;
      let raf = 0;
      let tx = 0;
      let ty = 0;
      let cx = 0;
      let cy = 0;

      function render() {
        cx += (tx - cx) * 0.18;
        cy += (ty - cy) * 0.18;
        el.style.transform = `perspective(1200px) rotateX(${cx.toFixed(2)}deg) rotateY(${cy.toFixed(2)}deg)`;
        if (Math.abs(tx - cx) > 0.01 || Math.abs(ty - cy) > 0.01) {
          raf = requestAnimationFrame(render);
        } else {
          raf = 0;
        }
      }
      function kick() {
        if (!raf) raf = requestAnimationFrame(render);
      }

      card.addEventListener("mousemove", (e) => {
        const r = el.getBoundingClientRect();
        const px = (e.clientX - r.left) / r.width - 0.5;
        const py = (e.clientY - r.top) / r.height - 0.5;
        ty = px * MAX * 2;
        tx = -py * MAX * 2;
        el.style.transitionDuration = "0ms";
        kick();
      });
      card.addEventListener("mouseleave", () => {
        tx = 0;
        ty = 0;
        el.style.transitionDuration = "600ms";
        kick();
      });
    });
  }
</script>
