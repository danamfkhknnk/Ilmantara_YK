---
import Layout from "../layouts/Layout.astro";
import WorkHeader from "../components/work/WorkHeader.astro";
import WorkCases from "../components/work/WorkCases.astro";
import Clients from "../components/home/Clients.astro";
import Process from "../components/home/Process.astro";
import Testimonials from "../components/home/Testimonials.astro";

// Static project list — CMS integration removed, edit directly here.
const projects = [
  {
    title: "Premium Shopify Website & E-commerce Store for Wellness Brands",
    name: "myart",
    slug: "myart",
    description:
      "With hands-on experience building custom third-party Shopify apps using Laravel, I help store owners solve problems that native Shopify features and existing apps simply can't cover.",
    category: "Shopify Template",
    year: "2025",
    url: "https://test-ihmol6aj.myshopify.com/",
    imageUrl: "/images/work/project-wellness.png",
    imageAlt: "Wellness brands Shopify store",
    priority: true,
  },
  {
    title: "Interactive Shopify Art Commission with Real-Time VRM Face Tracking",
    name: "miseart",
    slug: "miseart",
    description:
      "With a strong focus on creative, interactive Shopify experiences, I help brands stand out in a crowded eCommerce space by combining clean, conversion-focused design with cutting-edge interactivity that visitors actually remember.",
    category: "Shopify Template",
    year: "2025",
    url: "https://mise-u5ukp4yf.myshopify.com",
    imageUrl: "/images/work/project-vrm.png",
    imageAlt: "Art commission site with real-time VRM face tracking",
    priority: true,
  },
];
const years = projects.map((p) => p.year).filter(Boolean).sort();
const range =
  years.length === 0
    ? ""
    : years[0] === years[years.length - 1]
      ? years[0]
      : `${years[0]}-${years[years.length - 1]}`;
const tags = [...new Set(projects.map((p) => p.category).filter(Boolean))].join(", ");
const headerFacts = {
  count: `${projects.length} case ${projects.length === 1 ? "study" : "studies"}`,
  range,
  tags: tags || undefined,
};
---

<Layout title="Work · Ilmantara">
  <WorkHeader
    count={headerFacts.count}
    range={headerFacts.range}
    tags={headerFacts.tags}
  />
  <WorkCases />
  <Process index="04" active="01" />
  <Testimonials index="05" />
</Layout>
