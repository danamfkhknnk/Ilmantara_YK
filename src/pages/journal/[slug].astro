---
import Layout from "../../layouts/Layout.astro";
import JournalCard from "../../components/journal/JournalCard.astro";
import { POSTS, AUTHOR } from "../../data/journal";

export function getStaticPaths() {
  return POSTS.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const more = POSTS.filter((p) => p.slug !== post.slug).slice(0, 3);
---

<Layout title={`${post.title} · Ilmantara`}>
  <div class="bg-paper text-ink">
    <article class="mx-auto max-w-[1312px] px-5 pb-24 pt-[120px] sm:px-8 md:pt-[150px] lg:px-16">
      <!-- 01 Post header -->
      <header class="mx-auto max-w-[900px] text-center">
        <p class="flex items-center justify-center gap-3 font-mono text-[11px] font-medium uppercase tracking-[0.05em]">
          <span class="text-accent">{post.tag}</span>
          <span class="text-ink/45">{post.date}</span>
          <span class="text-ink/45">{post.readTime}</span>
        </p>
        <h1 class="mt-5 text-balance text-[clamp(44px,7vw,88px)] font-semibold leading-[0.98] tracking-[-0.04em]">
          {post.title}
        </h1>
        <p class="mx-auto mt-6 max-w-[720px] text-balance text-[19px] leading-[1.5] text-ink/70 md:text-[21px]">
          {post.excerpt}
        </p>
      </header>

      <!-- 02 Cover -->
      <figure class="mt-10 overflow-hidden rounded-[24px] md:mt-14">
        <img src={post.cover} alt={post.coverAlt} class="aspect-[16/9] w-full object-cover" />
      </figure>

      <!-- 03 Body -->
      <div class="mx-auto mt-10 max-w-[720px] md:mt-14">
        {post.body.map((para) => (
          <p class="mb-6 text-[18px] leading-[1.65] tracking-[-0.01em] text-ink/80 last:mb-0">
            {para}
          </p>
        ))}
      </div>

      <!-- 04 Author -->
      <aside class="mx-auto mt-12 flex max-w-[720px] flex-col gap-4 rounded-2xl border border-ink/[0.09] bg-white p-6 shadow-[0_22px_44px_-34px_rgba(12,12,14,0.5)] sm:flex-row sm:items-center md:mt-16">
        <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-accent text-sm font-semibold text-white" aria-hidden="true">
          {AUTHOR.initials}
        </span>
        <div class="min-w-0">
          <p class="text-[15px] font-semibold text-ink">Written by {AUTHOR.name}</p>
          <p class="mt-1 text-sm leading-relaxed text-ink/60">{AUTHOR.bio}</p>
        </div>
        <a
          href={`mailto:${AUTHOR.email}`}
          class="inline-flex shrink-0 items-center gap-2 text-sm font-medium text-ink underline underline-offset-4 hover:text-accent sm:ml-auto"
        >
          Say hello →
        </a>
      </aside>

      <!-- 05 More essays -->
      <section aria-label="More essays" class="mt-16 md:mt-24">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="flex items-center gap-2.5 font-mono text-[11px] font-medium uppercase tracking-[0.05em] text-ink/55">
              <span class="text-accent">[05]</span> Keep reading
            </p>
            <h2 class="mt-4 text-[36px] font-semibold leading-[1.02] tracking-[-0.03em] md:text-[48px]">
              More essays
            </h2>
          </div>
          <a href="/journal" class="pb-1 text-sm font-medium text-ink underline underline-offset-4 hover:text-accent">
            All essays →
          </a>
        </div>
        <div class="mt-8 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
          {more.map((p) => (
            <JournalCard post={p} />
          ))}
        </div>
      </section>
    </article>
  </div>
</Layout>
